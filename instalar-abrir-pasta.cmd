@echo off
rem Projetos Sync - instalador do "Abrir pasta": clicar num caminho G:\... no site abre a pasta no Windows.
rem Nao precisa ser administrador. Para tirar: reg delete HKCU\Software\Classes\abrirpasta /f
setlocal
set "DEST=%LOCALAPPDATA%\ProjetosSync"
if not exist "%DEST%" mkdir "%DEST%"
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$d=Join-Path $env:LOCALAPPDATA 'ProjetosSync'; [IO.File]::WriteAllBytes((Join-Path $d 'abrir-pasta.ps1'), [Convert]::FromBase64String('')); [IO.File]::WriteAllBytes((Join-Path $d 'abrir-pasta.vbs'), [Convert]::FromBase64String(''))"
if not exist "%DEST%\abrir-pasta.vbs" goto erro
reg add "HKCU\Software\Classes\abrirpasta" /ve /d "URL:Abrir pasta (Projetos Sync)" /f >nul
reg add "HKCU\Software\Classes\abrirpasta" /v "URL Protocol" /d "" /f >nul
reg add "HKCU\Software\Classes\abrirpasta\shell\open\command" /ve /d "wscript.exe \"%DEST%\abrir-pasta.vbs\" \"%%1\"" /f >nul
echo.
echo  Pronto! Agora, no site Projetos Sync, clique num caminho G:\... e a pasta abre no Windows.
echo  Na primeira vez o navegador pergunta se pode abrir: marque "Sempre permitir" e clique em Abrir.
echo.
if /I not "%~1"=="/q" pause
exit /b 0
:erro
echo  Nao deu para instalar. Tente de novo ou chame quem cuida do Projetos Sync.
if /I not "%~1"=="/q" pause
exit /b 1
